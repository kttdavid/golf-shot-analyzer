# 複製這個檔案成 .env 再填入。.env 不會被上傳到 GitHub。
# 上線時，把這些變數填到 Vercel 的 Environment Variables。

# 必填：Claude API 金鑰（在 console.anthropic.com 建立）
ANTHROPIC_API_KEY=

# 選填：存取碼。填了之後，訪客第一次分析要輸入這組碼。留空 = 不需要存取碼
ACCESS_CODE=

# 選填：每個 IP 每天可呼叫的次數（一次分析約 5 次呼叫）。留空 = 60
DAILY_LIMIT_PER_IP=

# 選填：使用的模型。留空 = claude-sonnet-5-5
MODEL_DEFAULT=
MODEL_COMPLEX=
