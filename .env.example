# 複製這個檔案成 .env 再填入。.env 不會被上傳到 GitHub。
# 上線時，把這些變數填到 Vercel 的 Environment Variables。

# AI 金鑰：兩個擇一填。只填 GEMINI_API_KEY 就用 Gemini；填了 ANTHROPIC_API_KEY 就用 Claude。
# Claude API 金鑰（在 console.anthropic.com 建立，按用量付費）
ANTHROPIC_API_KEY=
# Google Gemini API 金鑰（在 aistudio.google.com 建立，有免費額度）
GEMINI_API_KEY=

# 選填：兩把金鑰都填時，用這個指定要用哪一個（claude 或 gemini）
AI_PROVIDER=

# 選填：存取碼。填了之後，訪客第一次分析要輸入這組碼。留空 = 不需要存取碼
ACCESS_CODE=

# 選填：每個 IP 每天可呼叫的次數（一次分析約 5 次呼叫）。留空 = 60
DAILY_LIMIT_PER_IP=

# 選填：使用的模型。留空 = claude-sonnet-5-5
MODEL_DEFAULT=
MODEL_COMPLEX=

# 選填：Gemini 使用的模型。留空 = gemini-flash-latest
GEMINI_MODEL=
GEMINI_MODEL_COMPLEX=
